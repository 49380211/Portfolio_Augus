---
// Portada: nombre gigante, tag y subtítulo.
---

  <section class="hero" id="top">
    <div class="hwrap">
      <span class="tag">Portfolio · 2026</span>
      <h1 class="title" aria-label="Augusto Gercovich"><span class="l" aria-hidden="true">Augusto</span><span class="l" aria-hidden="true">Gercovich</span></h1>
      <p class="sub">Tecnología, producto y procesos. Último año de TIC en ORT Argentina.</p>
    </div>

  </section>

<style is:global>
/* portada */
.hero{position:relative;height:100svh;min-height:560px;display:grid;place-items:center;overflow:hidden}
.hero .hwrap{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:clamp(14px,2.4vh,26px)}
.hero .tag{font-size:12px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--ink);border-radius:3px;padding:5px 10px}
.hero .sub{margin:0;font-size:15px;color:var(--ink-2);text-align:center}
.pencils{position:absolute;bottom:0;z-index:1;width:min(34vw,520px);height:min(42svh,380px);pointer-events:none;overflow:visible}
.pencils.l{left:0}.pencils.r{right:0;transform:scaleX(-1)}
.pencils g{transform-box:fill-box;transform-origin:50% 100%}
.pics{position:absolute;left:50%;bottom:0;z-index:3;display:flex;gap:clamp(10px,1.2vw,18px);transform:translateX(-50%);align-items:flex-end}
.pic{position:relative;width:clamp(120px,12vw,190px);aspect-ratio:4/3;background:var(--card);border:1px solid rgba(18,22,19,.08);overflow:hidden;margin-bottom:-26px;box-shadow:0 18px 30px rgba(18,22,19,.1);transition:margin-bottom .5s cubic-bezier(.2,.8,.2,1)}
.pic:hover{margin-bottom:-6px}
.pic > div{position:absolute;inset:0}
.pic svg{position:absolute;inset:8%;width:84%;height:84%}
.pic .lb{position:absolute;left:6px;top:6px;font-size:10.5px;font-weight:500;color:var(--ink);background:rgba(244,244,241,.92);padding:2px 6px;border-radius:2px;z-index:2}
.hero h1{margin:0;text-align:center;font-size:min(17vw,25svh);position:relative;z-index:2}
.hero h1 .l{display:block;white-space:nowrap;overflow:hidden;padding:.04em .02em 0}
.hero h1 .c{display:inline-block}
.hero h1 .o{color:var(--accent)}


@media (max-width:820px){
  .pencils{width:46vw;height:24svh}
  .pic:nth-child(n+4){display:none}
  .pic{width:27vw}
  .hero h1{font-size:19vw}
  .hero .c3{white-space:nowrap;left:var(--gut);transform:none}
}
</style>
