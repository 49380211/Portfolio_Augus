---
// Sobre mí: la frase grande, las habilidades y la trayectoria.
import Skills from "./Skills.astro";
import Education from "./Education.astro";
---

  <section class="about" id="sobre" aria-labelledby="sobreT">
    <div class="lab" id="sobreT">Sobre mí</div>
    <p class="big">Me gusta entender cómo funcionan las cosas: una obra, una lección, un motor de juego, una PC. <em>Después, ordenarlas para que funcionen mejor.</em></p>
    <Skills />
    <Education />
  </section>

<style is:global>
/* sobre mí */
.about{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;padding:clamp(80px,14vh,160px) var(--gut)}
.about .lab{grid-column:1 / span 2;font-size:13px;color:var(--muted)}
.about .big{grid-column:3 / span 7;margin:0 0 50px;font-size:clamp(26px,2.9vw,46px);line-height:1.12;letter-spacing:-.025em;font-weight:500}
.about .big em{font-style:normal;color:var(--muted)}
.about .cols{grid-column:3 / span 9;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:34px 24px}
.about h3{margin:0 0 10px;font-size:13px;font-weight:500;color:var(--muted);border-top:1px solid var(--line);padding-top:10px}
.about ul{list-style:none;margin:0;padding:0;font-size:15px;line-height:1.6}
@media (max-width:820px){
  .about .lab,.about .big,.about .cols{grid-column:1 / -1}
  .about .cols{grid-template-columns:1fr 1fr}
}
</style>
