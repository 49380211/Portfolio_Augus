---
// Hoja del caso de estudio. main.js la rellena al abrir un proyecto.
---

<section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sTitle" data-lenis-prevent>
  <div class="in">
    <div class="top"><span id="sNum"></span><button class="x ul-link" id="sClose">Cerrar <i>✕</i></button></div>
    <div class="s-head">
      <h2 class="title" id="sTitle"></h2>
      <p class="line" id="sLine"></p>
      <div class="facts" id="sFacts"></div>
    </div>
    <div class="s-vis" id="sVis"></div>
    <div class="s-rows"><dl id="sRows"></dl><div class="tags" id="sTags"></div></div>
    <div class="s-gal" id="sGal"></div>
    <div class="exit" aria-hidden="true"><span>Seguí bajando para volver <b>↓</b></span><span class="tr"><i id="exitBar"></i></span></div>
  </div>
</section>

<style is:global>
/* caso de estudio */
.sheet{position:fixed;inset:0;z-index:35;background:var(--bg);overflow:auto;overscroll-behavior:contain;visibility:hidden}
.sheet .in{min-height:100%;padding:18px var(--gut) 34px}
.sheet .top{display:flex;justify-content:space-between;align-items:center;font-size:13px}
.sheet .x{display:flex;gap:10px;align-items:center}
.sheet .x i{font-style:normal;display:inline-block;transition:transform .4s}
.sheet .x:hover i{transform:rotate(90deg)}
.s-head{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;padding:clamp(60px,12vh,130px) 0 30px}
.s-head h2{grid-column:1 / span 12;margin:0;font-size:min(15vw,26svh)}
.s-head h2 .c{display:inline-block}
.s-head h2 .wd{display:inline-block;white-space:nowrap}
.s-head .line{grid-column:1 / span 5;font-size:clamp(20px,1.9vw,28px);line-height:1.2;letter-spacing:-.02em;font-weight:500;margin:26px 0 0}
.s-head .facts{grid-column:7 / span 6;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:30px;font-size:13px}
.s-head .facts span{display:block;color:var(--muted)}
.s-vis{position:relative;aspect-ratio:16/8.4;background:var(--card);overflow:hidden;margin:20px 0 0}
.s-vis > div{position:absolute;inset:0}
.s-rows{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;padding:50px 0 10px}
.s-rows dl{grid-column:4 / span 8;margin:0;display:grid}
.s-rows dl div{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3fr);gap:24px;border-top:1px solid var(--line);padding:16px 0}
.s-rows dt{font-size:13px;color:var(--muted)}
.s-rows dd{margin:0;font-size:clamp(16px,1.3vw,19px);line-height:1.4;color:var(--ink)}
.s-rows .tags{grid-column:4 / span 8;font-size:13px;color:var(--muted)}
.exit{display:flex;flex-direction:column;align-items:center;gap:12px;padding:70px 0 6px;font-size:13px;color:var(--muted)}
.exit .tr{width:min(240px,50vw);height:2px;background:var(--line);overflow:hidden}
.exit .tr i{display:block;height:100%;background:var(--accent);transform:scaleX(0);transform-origin:left}
.exit b{font-weight:400;display:inline-block;animation:nudge 1.6s ease-in-out infinite}
@keyframes nudge{50%{transform:translateY(4px)}}
.s-gal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,2vw,28px);margin:10px 0 0}
.s-gal .wide{grid-column:1 / -1}
.s-gal .duo{grid-column:1 / -1;display:grid;grid-template-columns:minmax(0,3fr) minmax(0,1fr);gap:clamp(14px,2vw,28px);align-items:center}
.phone{justify-self:center;width:min(100%,260px);border-radius:30px;padding:8px;background:#1d1a19;box-shadow:0 24px 50px rgba(74,55,51,.2)}
.phone img{display:block;width:100%;border-radius:23px}
.s-gal figcaption{font-size:13px;color:var(--muted);margin-top:10px}
@media (max-width:820px){.s-gal,.s-gal .duo{grid-template-columns:1fr}}
.s-link{display:inline-block;margin-left:14px;color:var(--ink);border-bottom:1px solid currentColor}
.s-link:hover{color:var(--accent)}
@media (max-width:820px){
  .s-head .line,.s-head .facts,.s-rows dl,.s-rows .tags{grid-column:1 / -1}
  .s-rows dl div{grid-template-columns:1fr;gap:4px}
  .s-vis{aspect-ratio:4/3}
}
@media (prefers-reduced-motion:reduce){ .exit b{animation:none} }
</style>
