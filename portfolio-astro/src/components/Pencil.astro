---
// Lápiz SVG que sigue al cursor, con su sombra.
---

<div id="penShadow" aria-hidden="true"></div>
<div id="pencil" aria-hidden="true">
  <svg viewBox="0 0 560 44">
    <defs>
      <linearGradient id="pBody" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFB083"/><stop offset=".18" stop-color="#FF7A3D"/><stop offset=".34" stop-color="#FF611A"/><stop offset=".36" stop-color="#F45A15"/><stop offset=".64" stop-color="#E9520F"/><stop offset=".66" stop-color="#D0470A"/><stop offset="1" stop-color="#A33705"/></linearGradient>
      <linearGradient id="pWood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F6E3C5"/><stop offset=".5" stop-color="#E2C49A"/><stop offset="1" stop-color="#B98F5E"/></linearGradient>
      <linearGradient id="pLead" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5A5B58"/><stop offset="1" stop-color="#151514"/></linearGradient>
      <linearGradient id="pMetal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FAFAF8"/><stop offset=".3" stop-color="#C9C8C3"/><stop offset=".5" stop-color="#8E8D88"/><stop offset=".72" stop-color="#E4E3DF"/><stop offset="1" stop-color="#76756F"/></linearGradient>
      <linearGradient id="pEraser" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6A6A66"/><stop offset=".5" stop-color="#2E2E2C"/><stop offset="1" stop-color="#161615"/></linearGradient>
    </defs>
    <polygon points="22,16.4 76,2.6 76,41.4 22,27.6" fill="url(#pWood)"/>
    <g stroke="#B08454" stroke-width=".6" opacity=".55" fill="none"><path d="M30 18 Q50 14 74 9"/><path d="M28 24 Q52 24 74 26"/><path d="M30 26 Q50 31 74 36"/></g>
    <polygon points="0,22 22,16.4 22,27.6" fill="url(#pLead)"/>
    <path d="M76 2.6 L470 2.6 L470 41.4 L76 41.4 Q83 35 76 28.4 Q83 22 76 15.6 Q83 9 76 2.6 Z" fill="url(#pBody)"/>
    <rect x="82" y="5" width="388" height="2.4" fill="#fff" opacity=".28"/>
    <line x1="82" y1="15.4" x2="470" y2="15.4" stroke="#7A2A04" stroke-opacity=".25" stroke-width=".8"/>
    <line x1="82" y1="28.6" x2="470" y2="28.6" stroke="#7A2A04" stroke-opacity=".3" stroke-width=".8"/>
    <text x="250" y="25" font-family="Hanken Grotesk, Arial, sans-serif" font-size="8.5" font-weight="600" letter-spacing="1.4" fill="#1C1C1B" fill-opacity=".72">AUGUSTO GERCOVICH</text>
    <text x="392" y="25" font-family="Hanken Grotesk, Arial, sans-serif" font-size="8.5" font-weight="600" letter-spacing="1" fill="#1C1C1B" fill-opacity=".72">HB · 2026</text>
    <rect x="470" y="1.6" width="50" height="40.8" fill="url(#pMetal)"/>
    <g stroke="#5E5D59" stroke-width="1.1" opacity=".75"><line x1="479" y1="1.6" x2="479" y2="42.4"/><line x1="484" y1="1.6" x2="484" y2="42.4"/><line x1="505" y1="1.6" x2="505" y2="42.4"/><line x1="510" y1="1.6" x2="510" y2="42.4"/></g>
    <rect x="519" y="3.6" width="40" height="36.8" rx="8" fill="url(#pEraser)"/>
    <rect x="524" y="7" width="30" height="3" rx="1.5" fill="#fff" opacity=".12"/>
  </svg>
</div>


<style is:global>
/* lápiz: estelas de movimiento */
.pghost{position:fixed;z-index:44;left:0;top:-22px;width:560px;height:44px;transform-origin:0 22px;pointer-events:none;opacity:0;will-change:transform,opacity}
.pghost svg{display:block;width:100%;height:100%}
/* lápiz */
#pencil{position:fixed;z-index:45;left:0;top:-22px;width:560px;height:44px;transform-origin:0 22px;pointer-events:none;will-change:transform;opacity:0}
#penShadow{position:fixed;z-index:44;left:0;top:-11px;width:560px;height:22px;transform-origin:0 11px;pointer-events:none;will-change:transform;opacity:0;border-radius:40% 20px 20px 40%;background:rgba(18,22,19,.34);filter:blur(12px)}
#pencil svg{display:block;width:100%;height:100%}

</style>
