---
// Proyectos: carrusel horizontal que avanza con el scroll. Las tarjetas las inyecta main.js en #track.
---

  <section class="work" id="proyectos" aria-label="Proyectos seleccionados">
    <div class="pin">
      <h2>Proyectos seleccionados <small id="workCount">01 / 05</small></h2>
      <div class="track" id="track"></div>
      <div class="hint"><span>Seguí bajando para ver más · click para abrir</span><span class="bar"><i id="workBar"></i></span></div>
    </div>
  </section>

<style is:global>
/* proyectos */
.work{padding:0 0 clamp(60px,10vh,120px)}
.work h2{margin:0;padding:0 var(--gut) 22px;font-weight:500;font-size:clamp(22px,1.9vw,30px);letter-spacing:-.02em;display:flex;justify-content:space-between;align-items:baseline}
.work h2 small{font-size:13px;color:var(--muted);font-weight:400;letter-spacing:0}
.track{display:flex;gap:clamp(12px,1.2vw,20px);padding:0 var(--gut);width:max-content;will-change:transform}
/* el carrusel avanza con el scroll vertical: la sección queda fija mientras las tarjetas pasan */
.work{position:relative;padding:0}
.work .pin{position:sticky;top:0;height:100svh;display:flex;flex-direction:column;justify-content:center;overflow:hidden}
.work .hint{display:flex;align-items:center;gap:18px}
.work .hint .bar{flex:0 0 min(220px,30vw);height:2px;background:var(--line);overflow:hidden}
.work .hint .bar i{display:block;height:100%;background:var(--ink);transform:scaleX(0);transform-origin:left}
.proj{flex:0 0 auto;width:min(52vw,62svh * 1.6,900px)}
.proj .vis{display:block;width:100%;position:relative;aspect-ratio:16/10;background:var(--card);overflow:hidden;transform-origin:center}
.proj .vis > div{position:absolute;inset:0}
.proj .meta{display:grid;grid-template-columns:28px minmax(0,2fr) minmax(0,1fr) minmax(0,1.4fr);gap:12px;padding:12px 0 0;font-size:13px;line-height:1.35}
.proj .meta .nm b{font-weight:500}
.proj .meta .nm span{color:var(--muted)}
.proj .meta .rl span{display:block;color:var(--muted)}
.work .hint{padding:18px var(--gut) 0;font-size:13px;color:var(--muted)}

@media (max-width:820px){
  .proj{width:82vw}
  .proj .meta{grid-template-columns:24px 1fr 1fr}
  .proj .meta .rl{display:none}
}
</style>
