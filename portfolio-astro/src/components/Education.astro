---
// Formación, certificaciones e idiomas.
---

    <div class="cv">
      <h3>Formación</h3>
      <div class="r"><span class="gray">Próximo paso</span><b>ITBA</b><span>Ingeniería Industrial (todavía no empecé)</span></div>
      <div class="r"><span class="gray">2022 — 2026</span><b>ORT Argentina</b><span>Tecnologías de la Información y la Comunicación (TIC)</span></div>
      <div class="r"><span class="gray">2014 — 2021</span><b>Colegio Bayard</b><span>Escuela primaria</span></div>
      <h3>Certificaciones</h3>
      <div class="r"><span class="gray">Cambridge</span><b>Advanced English (CAE)</b><span>Certificate in Advanced English</span></div>
      <div class="r"><span class="gray">Cambridge</span><b>First Certificate (FCE)</b><span>First Certificate in English</span></div>
      <div class="r"><span class="gray">Programa</span><b>Liderazgo y gestión de grupos</b><span>Leadership and Group Management Training Program</span></div>
      <h3>Idiomas</h3>
      <div class="r"><span class="gray">Nativo</span><b>Español</b><span></span></div>
      <div class="r"><span class="gray">Bilingüe</span><b>Inglés</b><span>Certificado CAE</span></div>
    </div>

<style is:global>
/* trayectoria */
.about .cv{grid-column:3 / span 9;margin-top:70px}
.about .cv h3{margin:34px 0 0}
.about .cv h3:first-child{margin-top:0}
.about .cv .r{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr) minmax(0,2fr);gap:16px;padding:14px 0;border-bottom:1px solid var(--line);font-size:15px}
.about .cv .r b{font-weight:500}
.about .cv .r > span:last-child{color:var(--ink-2)}
@media (max-width:820px){.about .cv{grid-column:1 / -1}.about .cv .r{grid-template-columns:1fr 1.4fr}.about .cv .r > span:last-child{grid-column:2}}
</style>
