---
// <head>, fuentes, estilos globales y SEO.
import '../styles/global.css';
import '../styles/visuals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Augusto Gercovich — Tecnología, producto y procesos',
  description = 'Portfolio de Augusto Gercovich: tecnología, producto y procesos.',
} = Astro.props;

// Astro.site sale de `site` en astro.config.mjs. Si no está puesto, se omiten
// la URL canónica y og:url en vez de publicar una dirección equivocada.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{canonical && <link rel="canonical" href={canonical} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#F4F4F1">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Augusto Gercovich">
<meta property="og:locale" content="es_AR">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
{canonical && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Hanken+Grotesk:wght@400;500;600&display=swap">
</head>
<body class="loading">
<slot />
<script>
  import "../scripts/main.js";
</script>
</body>
</html>
