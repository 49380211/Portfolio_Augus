---
/* Pasa las imágenes de los proyectos por astro:assets y publica el mapa de URLs ya optimizadas.
   Hace falta este puente porque las galerías y los visuales los arma el JS en runtime,
   y <Image /> sólo corre en build. */
import { getImage } from 'astro:assets';
import { projectImages } from '../data/images';

const entries = await Promise.all(
  Object.entries(projectImages).map(async ([key, img]) => {
    const opt = await getImage({ src: img, format: 'webp', quality: 82 });
    return [key, { src: opt.src, width: img.width, height: img.height }];
  })
);
const map = Object.fromEntries(entries);
---

<script type="application/json" id="project-images" set:html={JSON.stringify(map)} />
