<style is:global>
/* encabezado */
.hdr{position:fixed;left:0;right:0;top:0;z-index:30;display:grid;grid-template-columns:1fr 2fr;gap:16px;padding:18px var(--gut);font-size:13px;mix-blend-mode:difference;color:#F4F4F1}
